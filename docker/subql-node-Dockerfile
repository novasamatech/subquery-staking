# Required build args come from versions.env; see README.md.
ARG NODE_IMAGE
ARG SUBQL_NODE_IMAGE

FROM ${NODE_IMAGE} AS build

COPY . /project
WORKDIR /project
RUN yarn install --frozen-lockfile && yarn codegen && yarn build

FROM ${SUBQL_NODE_IMAGE}

COPY --from=build /project /project
RUN npm --prefix /project test -- --runInBand
